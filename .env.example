SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# New users wait for approval (1) or can sign in immediately (0)
REQUIRE_APPROVAL=1
# Emails (forgot password). Use ONE option. Brevo API works on Render free plan.
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=you@example.com
# Optional: DATA_DIR=/var/data (persistent disk), BASE_URL=https://your-app.onrender.com
# Optional: INSTAGRAM_URL= YOUTUBE_URL= X_URL= LINKEDIN_URL=
# Registration email OTP: auto = ON only when a mail provider (BREVO_API_KEY etc.) is set, 1 = always ON (code printed in logs if no mail), 0 = OFF
REQUIRE_EMAIL_OTP=auto
